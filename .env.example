# ==============================================================================
# Ricton Healthcare Platform - Environment Variables Template (.env.example)
# ==============================================================================

# PostgreSQL Connection String
DATABASE_URL="postgresql://ricton:password@localhost:5432/ricton?schema=public"

# Redis Connection
REDIS_URL="redis://localhost:6379"
REDIS_PASSWORD="replace_me_with_redis_password"
# Host port for the dev-stack redis container (docker-compose.yml). Override
# with REDIS_HOST_PORT=6380 when a local redis already occupies 6379.
# REDIS_HOST_PORT=6379
# Same for postgres when a local postgres already occupies 5432.
# POSTGRES_HOST_PORT=5433

# JWT Secrets (generate with: bash scripts/gen-prod-secrets.sh — NEVER commit real values)
JWT_SECRET="replace_me_with_64_hex_chars_min_32"
REFRESH_SECRET="replace_me_with_64_hex_chars_min_32"
OTP_SECRET="replace_me_with_64_hex_chars_min_32"

# CORS
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:5173,http://localhost:19006"

# Public frontend origin + gateway URL (staging/prod). The renewal worker and
# subscription callbacks derive success/redirect URLs from FRONTEND_URL.
# Get the real value from your deployed domain (e.g. https://ricton.health).
FRONTEND_URL="http://localhost:3000"

# Service-to-service auth (generate with: bash scripts/gen-prod-secrets.sh)
INTERNAL_API_SECRET="replace_me_with_64_hex_chars_min_32"
# Internal notification base URL for payment/server callbacks (prod compose).
INTERNAL_NOTIFICATION_URL="http://notification-service:3016"

# Port Configuration (canonical — must match docker-compose.yml + apps/web/next.config.ts)
PORT_AUTH=3001
PORT_USER=3002
PORT_DOCS=3003
PORT_PRESCRIPTION=3004
PORT_APPOINTMENT=3005
PORT_ANALYTICS=3006
PORT_PAYMENT=3007
PORT_WALLET=3008
PORT_SUBSCRIPTION=3009
PORT_ADMIN=3010
PORT_REWARDS=3011
PORT_MESSAGING=3012
PORT_TELEMEDICINE=3013
PORT_PHARMACY=3014
PORT_ADDRESS=3015
PORT_NOTIFICATION=3016
PORT_SMARTGUARD=3017

# Paystack Configuration (dashboard.paystack.com → Settings → API Keys)
PAYSTACK_SECRET_KEY="sk_test_replace_me"
PAYSTACK_PUBLIC_KEY="pk_test_replace_me"
# Optional preferred bank for virtual-account top-ups (leave empty = Paystack default)
# PAYSTACK_PREFERRED_BANK=""

# Apple OAuth (developer.apple.com → Identifiers → App IDs / Services)
APPLE_CLIENT_ID="your_apple_client_id"

# Twilio Credentials (SMS OTP only — Programmable Video is sunset)
TWILIO_ACCOUNT_SID="your_twilio_account_sid"
TWILIO_AUTH_TOKEN="your_twilio_auth_token"
TWILIO_PHONE_NUMBER="+1234567890"

# LiveKit Video (telemedicine rooms, tokens, webhooks)
LIVEKIT_URL="wss://your-project.livekit.cloud"
LIVEKIT_API_KEY="your_livekit_api_key"
LIVEKIT_API_SECRET="your_livekit_api_secret_32_chars_min"
# Public HTTPS URL LiveKit calls for room webhooks (prod). Leave empty in dev.
TELEMEDICINE_CALLBACK_URL=""

# AWS / ECR / avatars (console.aws.amazon.com → IAM → access keys; ECR registry)
AWS_ACCOUNT_ID="000000000000"
AWS_REGION="eu-west-2"
AWS_ACCESS_KEY_ID="your_aws_access_key_id"
AWS_SECRET_ACCESS_KEY="your_aws_secret_access_key"
AWS_S3_BUCKET_NAME="ricton-avatars"
# Immutable release tag for prod images (CI sets IMAGE_TAG=github.sha)
IMAGE_TAG="dev"

# Error tracking (sentry.io → Projects → Client Keys). Leave empty to disable.
SENTRY_DSN=""

# SendGrid Email Configuration
SENDGRID_API_KEY="your_sendgrid_api_key"
SENDGRID_FROM_EMAIL="noreply@ricton.health"

# Google OAuth
GOOGLE_CLIENT_ID="your_google_client_id"
GOOGLE_CLIENT_SECRET="your_google_client_secret"
NEXT_PUBLIC_GOOGLE_CLIENT_ID="your_google_client_id"
# Production web builds talk to the gateway through this URL (no Next rewrites
# in production). The Docker build fails if it is empty.
NEXT_PUBLIC_API_URL="https://api.your-domain.com"

# Environment & Timeout
NODE_ENV="development"
SERVER_TIMEOUT=30000

# Google iOS OAuth client (mobile native sign-in; from Google Cloud Console,
# Credentials → Create Credentials → OAuth client ID → iOS, bundle id below)
# Must match an audience accepted by the backend (GOOGLE_IOS_CLIENT_ID).
# Public value by design — safe in EXPO_PUBLIC_* (identifies the app, not a secret).
# EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID="your_ios_client_id.apps.googleusercontent.com"

# Apple native sign-in accepts the iOS bundle ID as token audience.
# APPLE_IOS_BUNDLE_ID="com.ricton.health"
