# PostgreSQL connection string
DATABASE_URL="postgresql://ricton:password@localhost:5432/ricton?schema=public"

# Redis connection
REDIS_URL="redis://localhost:6379"

# JWT Secrets
JWT_SECRET="dev-secret-key-change-in-production"
REFRESH_SECRET="dev-refresh-secret-change-in-production"
OTP_SECRET="dev-otp-secret-change-in-production"

# CORS
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:5173,http://localhost:19006"

# Port Configuration
PORT_AUTH=3001
PORT_USER=3002
PORT_APPOINTMENT=3003
PORT_PRESCRIPTION=3004
PORT_TELEMEDICINE=3005
PORT_PHARMACY=3006
PORT_PAYMENT=3007
PORT_WALLET=3008
PORT_NOTIFICATION=3009
PORT_ADMIN=3010
PORT_ANALYTICS=3011

# Paystack Configuration
PAYSTACK_SECRET_KEY="sk_test_replace_me_with_your_real_key"
PAYSTACK_PUBLIC_KEY="pk_test_replace_me_with_your_real_key"

# Twilio Configuration
TWILIO_ACCOUNT_SID="your_twilio_account_sid"
TWILIO_AUTH_TOKEN="your_twilio_auth_token"
TWILIO_PHONE_NUMBER="+1234567890"

# SendGrid Configuration
SENDGRID_API_KEY="your_sendgrid_api_key"
SENDGRID_FROM_EMAIL="noreply@ricton.health"

# Google OAuth
GOOGLE_CLIENT_ID="your_google_client_id"

# Apple OAuth
APPLE_CLIENT_ID="your_apple_client_id"

# AWS S3
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID="your_aws_access_key_id"
AWS_SECRET_ACCESS_KEY="your_aws_secret_access_key"
AWS_S3_BUCKET_NAME="ricton-avatars"

# Observability
SENTRY_DSN=""
DATADOG_API_KEY=""
DD_SERVICE="ricton-backend"
DD_ENV="development"

# NODE_ENV
NODE_ENV="development"
# Server Configuration
SERVER_TIMEOUT=30000
