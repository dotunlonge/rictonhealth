# ==============================================================================
# Ricton Healthcare Platform - Environment Variables Template (.env.example)
# ==============================================================================

# PostgreSQL Connection String
DATABASE_URL="postgresql://ricton:password@localhost:5432/ricton?schema=public"

# Redis Connection
REDIS_URL="redis://localhost:6379"
REDIS_PASSWORD="replace_me_with_redis_password"
# Host port for the dev-stack redis container (docker-compose.yml). Override
# with REDIS_HOST_PORT=6380 when a local redis already occupies 6379.
# REDIS_HOST_PORT=6379
# Same for postgres when a local postgres already occupies 5432.
# POSTGRES_HOST_PORT=5433

# JWT Secrets (generate with: bash scripts/gen-prod-secrets.sh — NEVER commit real values)
JWT_SECRET="replace_me_with_64_hex_chars_min_32"
REFRESH_SECRET="replace_me_with_64_hex_chars_min_32"
OTP_SECRET="replace_me_with_64_hex_chars_min_32"
# TOTP at-rest encryption key (falls back to OTP_SECRET when empty; set it
# explicitly in production so rotation is independent)
TOTP_ENCRYPTION_KEY="replace_me_with_64_hex_chars_min_32"

# CORS (3100 is the repo's web dev port; 3000 belongs to an unrelated project)
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:3100,http://localhost:5173,http://localhost:19006"

# Public frontend origin + gateway URL (staging/prod). The renewal worker and
# subscription callbacks derive success/redirect URLs from FRONTEND_URL.
# Get the real value from your deployed domain (e.g. https://ricton.health).
FRONTEND_URL="http://localhost:3000"

# Service-to-service auth (generate with: bash scripts/gen-prod-secrets.sh)
INTERNAL_API_SECRET="replace_me_with_64_hex_chars_min_32"
# Internal notification base URL for payment/server callbacks (prod compose).
INTERNAL_NOTIFICATION_URL="http://notification-service:3016"

# Port Configuration (canonical — must match docker-compose.yml + apps/web/next.config.ts)
PORT_AUTH=3001
PORT_USER=3002
PORT_DOCS=3003
PORT_PRESCRIPTION=3004
PORT_APPOINTMENT=3005
PORT_ANALYTICS=3006
PORT_PAYMENT=3007
PORT_WALLET=3008
PORT_SUBSCRIPTION=3009
PORT_ADMIN=3010
PORT_REWARDS=3011
# NOTE: messaging/notification/pharmacy services historically read MESSAGING_PORT,
# NOTIFICATION_PORT, PHARMACY_PORT. Canonical is now PORT_*; code accepts both
# (PORT_* first), so set the canonical names — legacy keys kept for compat.
PORT_MESSAGING=3012
MESSAGING_PORT=3012
PORT_TELEMEDICINE=3013
PHARMACY_PORT=3014
PORT_ADDRESS=3015
NOTIFICATION_PORT=3016
PORT_SMARTGUARD=3017

# Paystack Configuration (dashboard.paystack.com → Settings → API Keys)
PAYSTACK_SECRET_KEY="sk_test_replace_me"
PAYSTACK_PUBLIC_KEY="pk_test_replace_me"
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY="pk_test_replace_me"
# Optional preferred bank for virtual-account top-ups (leave empty = Paystack default).
# Must also exist as a deploy secret (PAYSTACK_PREFERRED_BANK) to reach staging/prod.
PAYSTACK_PREFERRED_BANK=""

# Apple OAuth (developer.apple.com → Identifiers → App IDs / Services)
APPLE_CLIENT_ID="your_apple_client_id"
# iOS bundle accepted as Apple token audience (backend APPLE_IOS_BUNDLE_ID)
APPLE_IOS_BUNDLE_ID="com.ricton.health"
# Web Apple button client (same Service ID value as APPLE_CLIENT_ID)
NEXT_PUBLIC_APPLE_CLIENT_ID="your_apple_client_id"

# Twilio Credentials (SMS OTP only — Programmable Video is sunset)
TWILIO_ACCOUNT_SID="your_twilio_account_sid"
TWILIO_API_KEY="your_twilio_api_key"
TWILIO_API_SECRET="your_twilio_api_secret"
TWILIO_AUTH_TOKEN="your_twilio_auth_token"
TWILIO_PHONE_NUMBER="+1234567890"

# LiveKit Video (telemedicine rooms, tokens, webhooks)
LIVEKIT_URL="wss://your-project.livekit.cloud"
LIVEKIT_API_KEY="your_livekit_api_key"
LIVEKIT_API_SECRET="your_livekit_api_secret_32_chars_min"
# Public HTTPS URL LiveKit calls for room webhooks (prod). Leave empty in dev.
# Register this URL as the LiveKit PROJECT webhook (Cloud dashboard →
# Webhooks, or self-hosted --webhook-url): the server SDK cannot attach a
# webhook per room, so room creation never sends this value to LiveKit.
TELEMEDICINE_CALLBACK_URL=""
# Join-window tuning (backend defaults 15 early / 30 late minutes)
TELEMEDICINE_JOIN_EARLY_MINUTES="15"
TELEMEDICINE_JOIN_LATE_MINUTES="30"

# AWS / ECR / avatars (console.aws.amazon.com → IAM → access keys; ECR registry)
AWS_ACCOUNT_ID="000000000000"
AWS_REGION="eu-west-2"
AWS_ACCESS_KEY_ID="your_aws_access_key_id"
AWS_SECRET_ACCESS_KEY="your_aws_secret_access_key"
AWS_S3_BUCKET_NAME="ricton-avatars"
# Immutable release tag for prod images (CI sets IMAGE_TAG=github.sha)
IMAGE_TAG="dev"

# Error tracking (sentry.io → Projects → Client Keys). Leave empty to disable.
SENTRY_DSN=""
# Sentry traces sample rate: 0.1 in prod, 1.0 locally.
SENTRY_TRACES_SAMPLE_RATE="0.1"

# SendGrid Email Configuration
SENDGRID_API_KEY="your_sendgrid_api_key"
SENDGRID_FROM_EMAIL="noreply@ricton.health"

# Google OAuth
GOOGLE_CLIENT_ID="your_google_client_id"
GOOGLE_CLIENT_SECRET="your_google_client_secret"
# iOS OAuth client accepted as token audience alongside the web client ID
GOOGLE_IOS_CLIENT_ID="your_ios_client_id.apps.googleusercontent.com"
NEXT_PUBLIC_GOOGLE_CLIENT_ID="your_google_client_id"
# Production web builds talk to the gateway through this URL (no Next rewrites
# in production). The Docker build fails if it is empty.
NEXT_PUBLIC_API_URL="https://api.your-domain.com"

# Environment & Timeout
NODE_ENV="development"
SERVER_TIMEOUT=30000

# Force-update gate (#107): GET /version served by the admin service (public,
# gateway /api/version). Mobile blocks launch when its build is below
# minSupported. Defaults in code are 1.0.0 (mirror apps/mobile/app.json);
# raise these to force-update field builds.
MIN_APP_VERSION_IOS="1.0.0"
MIN_APP_VERSION_ANDROID="1.0.0"
MIN_APP_VERSION_WEB="1.0.0"
LATEST_APP_VERSION="1.0.0"

# Google iOS OAuth client (mobile native sign-in; from Google Cloud Console,
# Credentials → Create Credentials → OAuth client ID → iOS, bundle id below)
# Must match an audience accepted by the backend (GOOGLE_IOS_CLIENT_ID).
# Public value by design — safe in EXPO_PUBLIC_* (identifies the app, not a secret).
# EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID="your_ios_client_id.apps.googleusercontent.com"
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID="your_ios_client_id.apps.googleusercontent.com"
EXPO_PUBLIC_GOOGLE_CLIENT_ID="your_google_client_id"
# Production gateway for device builds (EAS build env). Dev default is
# http://127.0.0.1:8000/api (simulator); set the staging/prod HTTPS gateway here.
EXPO_PUBLIC_API_URL="http://127.0.0.1:8000/api"
