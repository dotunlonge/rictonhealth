generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -----------------------------------------------------------------------------
// CORE MODELS
// -----------------------------------------------------------------------------

enum UserRole {
  PATIENT
  CONSULTANT
  PHARMACIST
  HOSPITAL_ADMIN
  SUPER_ADMIN
}

enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

model User {
  rewardTransactions RewardTransaction[] @relation("UserRewardTransactions")
  id                 String              @id @default(uuid()) @db.Uuid
  email              String?             @unique
  phone              String?             @unique
  passwordHash       String?
  role               UserRole
  status             UserStatus          @default(PENDING)
  emailVerified      Boolean             @default(false)
  phoneVerified      Boolean             @default(false)
  oauthProvider      String?
  oauthId            String?
  consentVersion     String?
  consentAt          DateTime?           @db.Timestamptz(6)
  lastLoginAt        DateTime?           @db.Timestamptz(6)
  twoFactorEnabled   Boolean             @default(false)
  twoFactorSecret    String?
  tokenVersion       Int                 @default(0)
  bankDetails        Json?
  deletedAt          DateTime?           @db.Timestamptz(6)
  hospitalId         String?             @db.Uuid
  hospital           Hospital?           @relation("UserHospital", fields: [hospitalId], references: [id])
  createdAt          DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime            @updatedAt @db.Timestamptz(6)

  // Profiles
  patientProfile  PatientProfile?
  providerProfile ProviderProfile?
  pharmacyProfile PharmacyProfile?

  // Relations
  appointmentsAsPatient    Appointment[]             @relation("PatientAppointments")
  appointmentsAsProvider   Appointment[]             @relation("ProviderAppointments")
  prescriptionsAsPatient   Prescription[]            @relation("PatientPrescriptions")
  prescriptionsAsProvider  Prescription[]            @relation("ProviderPrescriptions")
  prescriptionsAsPharmacy  Prescription[]            @relation("PharmacyPrescriptions")
  pharmacyOrdersAsPatient  PharmacyOrder[]           @relation("PatientOrders")
  pharmacyOrdersAsPharmacy PharmacyOrder[]           @relation("PharmacyOrders")
  payments                 Payment[]
  wallet                   Wallet?
  notifications            Notification[]
  notificationPreferences  NotificationPreference?
  pushTokens               PushToken[]
  idempotencyKeys          IdempotencyKey[]
  telemedicineRoomsAsHost  TelemedicineRoom[]
  telemedicineParticipants TelemedicineParticipant[]
  auditLogsAsActor         AuditLog[]
  providerEarnings         ProviderEarning[]
  rewardPoints             RewardPoint[]
  subscriptions            Subscription[]
  providerAvailabilities   ProviderAvailability[]
  refreshTokens            RefreshToken[]
  addresses                Address[]
  chatThreadsAsParticipant ChatParticipant[]
  chatMessagesSent         ChatMessage[]
  chatMessageReceipts      ChatMessageReceipt[]
  mdtsAsPatient            MDT[]                     @relation("MdtPatient")
  mdtsAsCreator            MDT[]                     @relation("MdtCreator")
  mdtParticipants          MDTParticipant[]
  pharmacyProducts         Product[]
  rewardCatalogRedeemed    RewardCatalog[]           @relation("RewardRedeemedBy")
  providerLeaves           ProviderLeave[]
  referralsFrom            Referral[]                @relation("ReferralFrom")
  referralsTo              Referral[]                @relation("ReferralTo")
  referralsAsPatient       Referral[]                @relation("ReferralPatient")
  consentHistory           ConsentHistory[]
  erasureRequest           ErasureRequest?
  reviewsGiven             Review[]                  @relation("ReviewPatient")
  reviewsReceived          Review[]                  @relation("ReviewProvider")
  supportTickets           SupportTicket[]

  @@map("users")
}

model RefreshToken {
  id                String         @id @default(uuid()) @db.Uuid
  userId            String         @db.Uuid
  user              User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash         String         @unique
  deviceId          String?
  deviceFingerprint String?
  deviceIp          String?
  deviceOs          String?
  userAgent         String?
  isActive          Boolean        @default(true)
  isRevoked         Boolean        @default(false)
  revokedAt         DateTime?      @db.Timestamptz(6)
  revokeReason      String?
  parentTokenId     String?        @db.Uuid
  parentToken       RefreshToken?  @relation("RefreshTokenFamily", fields: [parentTokenId], references: [id])
  childTokens       RefreshToken[] @relation("RefreshTokenFamily")
  tokenFamily       String? // Family ID for tracking token rotation chain
  expiresAt         DateTime       @db.Timestamptz(6)
  createdAt         DateTime       @default(now()) @db.Timestamptz(6)
  lastUsedAt        DateTime?      @db.Timestamptz(6)
  usageCount        Int            @default(0)

  @@index([userId, isActive])
  @@index([deviceId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model PatientProfile {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @unique @db.Uuid
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName        String
  lastName         String
  dateOfBirth      DateTime? @db.Date
  gender           String?
  bloodType        String?
  allergies        Json? // Array of strings
  medicalHistory   Json? // Structured history
  emergencyContact Json? // { name, phone, relationship }
  avatarUrl        String?

  @@map("patient_profiles")
}

model ProviderProfile {
  id              String    @id @default(uuid()) @db.Uuid
  userId          String    @unique @db.Uuid
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName       String
  lastName        String
  title           String? // Dr., Prof., etc.
  specialty       String?
  licenseNumber   String?
  hospitalId      String?   @db.Uuid
  hospital        Hospital? @relation(fields: [hospitalId], references: [id])
  bio             String?
  consultationFee Decimal?  @db.Decimal(10, 2)
  yearsExperience Int?
  isVerified      Boolean   @default(false)
  avatarUrl       String?
  rating          Decimal?  @db.Decimal(3, 2)
  onboardingStep  Int       @default(1)
  documents       Json?
  idVerifiedAt    DateTime? @db.Timestamptz(6)
  // Public place of practice only. Never reuse a provider's private address.
  practiceAddress String?
  practiceCity    String?
  practiceState   String?
  practiceLatitude  Decimal? @db.Decimal(10, 8)
  practiceLongitude Decimal? @db.Decimal(11, 8)
  practiceLocationVisible Boolean @default(false)

  @@index([practiceLocationVisible, practiceLatitude, practiceLongitude])
  @@map("provider_profiles")
}

model PharmacyProfile {
  id                 String  @id @default(uuid()) @db.Uuid
  userId             String  @unique @db.Uuid
  user               User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  pharmacyName       String
  licenseNumber      String?
  address            Json?
  location           Json? // { lat: number, lng: number }
  operatingHours     Json?
  documents          Json?
  bankDetails        Json?
  onboardingComplete Boolean @default(false)
  isVerified         Boolean @default(false)

  @@map("pharmacy_profiles")
}

// -----------------------------------------------------------------------------
// CLINICAL MODELS
// -----------------------------------------------------------------------------

model Hospital {
  id                 String   @id @default(uuid()) @db.Uuid
  name               String
  address            Json?
  phone              String?
  email              String?
  logoUrl            String?
  registrationNumber String?
  documents          Json?
  onboardingComplete Boolean  @default(false)
  departments        Json?
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now()) @db.Timestamptz(6)

  providers    ProviderProfile[]
  appointments Appointment[]
  users        User[]            @relation("UserHospital")

  @@map("hospitals")
}

model ProviderAvailability {
  id                  String   @id @default(uuid()) @db.Uuid
  providerId          String   @db.Uuid
  provider            User     @relation(fields: [providerId], references: [id], onDelete: Cascade)
  dayOfWeek           Int // 0=Mon, 6=Sun
  startTime           String // "09:00:00"
  endTime             String // "17:00:00"
  slotDurationMinutes Int      @default(30)
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now()) @db.Timestamptz(6)

  @@unique([providerId, dayOfWeek])
  @@index([providerId, dayOfWeek, isActive])
  @@map("provider_availability")
}

enum AppointmentType {
  IN_PERSON
  VIDEO
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

model Appointment {
  id                    String                    @id @default(uuid()) @db.Uuid
  patientId             String                    @db.Uuid
  patient               User                      @relation("PatientAppointments", fields: [patientId], references: [id])
  providerId            String                    @db.Uuid
  provider              User                      @relation("ProviderAppointments", fields: [providerId], references: [id])
  hospitalId            String?                   @db.Uuid
  hospital              Hospital?                 @relation(fields: [hospitalId], references: [id])
  scheduledAt           DateTime                  @db.Timestamptz(6)
  durationMinutes       Int
  timeRange             Unsupported("tstzrange")?
  type                  AppointmentType
  status                AppointmentStatus         @default(PENDING)
  cancellationReason    String?
  waivedReason          String?
  feeSnapshot           Decimal?                  @db.Decimal(10, 2)
  telemedicineConsentAt DateTime?                 @db.Timestamptz(6)
  reason                String?                   @db.Text
  notes                 String?
  reminderSentAt        DateTime?                 @db.Timestamptz(6)
  cancelledBy           UserRole?
  paymentId             String?                   @unique @db.Uuid
  payment               Payment?                  @relation("AppointmentPayment", fields: [paymentId], references: [id])
  telemedicineRoomId    String?                   @unique @db.Uuid
  telemedicineRoom      TelemedicineRoom?         @relation(fields: [telemedicineRoomId], references: [id])
  // #C2 Follow-up chain: optional link to the parent appointment + due date.
  // Nullable so existing rows safe; app layer sets both when booking follow-up.
  parentAppointmentId String?   @db.Uuid
  followUpAt          DateTime? @db.Timestamptz(6)
  createdAt             DateTime                  @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime                  @updatedAt @db.Timestamptz(6)

  prescriptions    Prescription[]
  providerEarnings ProviderEarning[]
  review           Review?

  @@index([patientId])
  @@index([providerId, scheduledAt])
  @@index([hospitalId])
  @@index([status])
  // #D3 composite for status-filtered schedule scans.
  @@index([status, scheduledAt])
  @@map("appointments")
}

enum PrescriptionStatus {
  DRAFT
  SIGNED
  SENT_TO_PHARMACY
  DISPENSED
  CANCELLED
}

model Prescription {
  id            String             @id @default(uuid()) @db.Uuid
  appointmentId String?            @db.Uuid
  appointment   Appointment?       @relation(fields: [appointmentId], references: [id])
  patientId     String             @db.Uuid
  patient       User               @relation("PatientPrescriptions", fields: [patientId], references: [id])
  providerId    String             @db.Uuid
  provider      User               @relation("ProviderPrescriptions", fields: [providerId], references: [id])
  pharmacyId    String?            @db.Uuid
  pharmacy      User?              @relation("PharmacyPrescriptions", fields: [pharmacyId], references: [id])
  status        PrescriptionStatus @default(DRAFT)
  signedAt      DateTime?          @db.Timestamptz(6)
  // #L4 Rx snapshot: prescriber license + signature hash captured at sign time.
  // Nullable so existing rows safe; populated best-effort in signPrescription.
  prescriberLicense String?
  signatureHash     String?
  notes         String?
  createdAt     DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime           @updatedAt @db.Timestamptz(6)

  items          PrescriptionItem[]
  pharmacyOrders PharmacyOrder[]

  @@index([patientId])
  @@index([providerId])
  @@index([pharmacyId])
  @@index([status])
  @@map("prescriptions")
}

model PrescriptionItem {
  id             String       @id @default(uuid()) @db.Uuid
  prescriptionId String       @db.Uuid
  prescription   Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  drugName       String
  dosage         String
  quantity       Int
  frequency      String
  duration       String
  instructions   String?
  createdAt      DateTime     @default(now()) @db.Timestamptz(6)

  @@map("prescription_items")
}

enum TelemedicineRoomType {
  ONE_ON_ONE
  MDT
}

enum TelemedicineRoomStatus {
  CREATED
  ACTIVE
  ENDED
}

model TelemedicineRoom {
  id              String                    @id @default(uuid()) @db.Uuid
  appointmentId   String?                   @unique @db.Uuid
  appointment     Appointment? // Relation handled from Appointment side
  providerId      String                    @db.Uuid
  provider        User                      @relation(fields: [providerId], references: [id])
  roomType        TelemedicineRoomType      @default(ONE_ON_ONE)
  externalRoomId  String // Twilio SID
  externalRoomUrl String?
  status          TelemedicineRoomStatus    @default(CREATED)
  startedAt       DateTime?                 @db.Timestamptz(6)
  endedAt         DateTime?                 @db.Timestamptz(6)
  createdAt       DateTime                  @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime                  @updatedAt @db.Timestamptz(6)
  mdtId           String?                   @db.Uuid
  mdt             MDT?                      @relation(fields: [mdtId], references: [id])
  participants    TelemedicineParticipant[]

  @@index([providerId])
  @@index([status])
  @@map("telemedicine_rooms")
}

enum ParticipantRole {
  HOST
  PARTICIPANT
}

model TelemedicineParticipant {
  id        String           @id @default(uuid()) @db.Uuid
  roomId    String           @db.Uuid
  room      TelemedicineRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  userId    String           @db.Uuid
  user      User             @relation(fields: [userId], references: [id])
  role      ParticipantRole  @default(PARTICIPANT)
  joinedAt  DateTime?        @db.Timestamptz(6)
  leftAt    DateTime?        @db.Timestamptz(6)
  createdAt DateTime         @default(now()) @db.Timestamptz(6)

  @@index([roomId])
  @@index([userId])
  @@map("telemedicine_participants")
}

// -----------------------------------------------------------------------------
// COMMERCE MODELS
// -----------------------------------------------------------------------------

enum OrderStatus {
  PLACED
  CONFIRMED
  PREPARING
  READY_FOR_PICKUP
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum DeliveryType {
  PICKUP
  DELIVERY
}

model PharmacyOrder {
  id              String        @id @default(uuid()) @db.Uuid
  patientId       String        @db.Uuid
  patient         User          @relation("PatientOrders", fields: [patientId], references: [id])
  pharmacyId      String        @db.Uuid
  pharmacy        User          @relation("PharmacyOrders", fields: [pharmacyId], references: [id])
  prescriptionId  String?       @db.Uuid
  prescription    Prescription? @relation(fields: [prescriptionId], references: [id])
  status          OrderStatus   @default(PLACED)
  deliveryAddress Json?
  deliveryType    DeliveryType  @default(PICKUP)
  totalAmount     Decimal       @db.Decimal(10, 2)
  paymentId       String?       @unique @db.Uuid
  payment         Payment?      @relation("OrderPayment", fields: [paymentId], references: [id])
  notes           String?
  createdAt       DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime      @updatedAt @db.Timestamptz(6)

  items OrderItem[]

  @@index([patientId])
  @@index([pharmacyId])
  @@index([status])
  @@map("pharmacy_orders")
}

model OrderItem {
  id        String        @id @default(uuid()) @db.Uuid
  orderId   String        @db.Uuid
  order     PharmacyOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String?       @db.Uuid
  drugName  String
  quantity  Int
  unitPrice Decimal       @db.Decimal(10, 2)
  subtotal  Decimal       @db.Decimal(10, 2)
  createdAt DateTime      @default(now()) @db.Timestamptz(6)

  @@index([productId])
  @@map("order_items")
}

enum PaymentType {
  APPOINTMENT
  PHARMACY_ORDER
  SUBSCRIPTION
  WALLET_TOPUP
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum PaymentProvider {
  PAYSTACK
  WALLET
}

model Payment {
  id                String          @id @default(uuid()) @db.Uuid
  userId            String          @db.Uuid
  user              User            @relation(fields: [userId], references: [id])
  amount            Decimal         @db.Decimal(10, 2)
  currency          String          @default("NGN")
  type              PaymentType
  status            PaymentStatus   @default(PENDING)
  provider          PaymentProvider
  providerReference String          @unique // Paystack reference
  providerTxId      String?
  metadata          Json?
  createdAt         DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime        @updatedAt @db.Timestamptz(6)

  appointment  Appointment?   @relation("AppointmentPayment")
  order        PharmacyOrder? @relation("OrderPayment")
  subscription Subscription?  @relation("SubscriptionPayment")

  @@index([userId])
  @@index([status])
  @@index([type])
  @@index([providerReference])
  @@map("payments")
}

model Wallet {
  id                   String   @id @default(uuid()) @db.Uuid
  userId               String   @unique @db.Uuid
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  balance              Decimal  @default(0) @db.Decimal(12, 2)
  virtualAccountNumber String?
  virtualBankName      String?
  currency             String   @default("NGN")
  isActive             Boolean  @default(true)
  createdAt            DateTime @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime @updatedAt @db.Timestamptz(6)

  transactions WalletTransaction[]

  @@map("wallets")
}

enum WalletTransactionType {
  CREDIT
  DEBIT
}

enum WalletReferenceType {
  TOPUP
  PAYMENT
  REFUND
  PAYOUT
}

model WalletTransaction {
  // NOTE (D4): @@unique([walletId, referenceId]) with nullable referenceId
  // intentionally untouched — changing it needs a migration. Skipped per #D4.
  // Postgres treats NULLs as distinct, so rows with NULL referenceId bypass
  // the idempotency guard at the DB layer. App-layer guard (creditWalletAtomic
  // / debitWalletAtomic fast-path + P2002 race catch) is authoritative for
  // reference-keyed writes; NULL-referenceId rows are non-idempotent by
  // design (ad-hoc adjustments). TODO: if NULL bypass ever matters, migrate
  // referenceId to NOT NULL DEFAULT uuid() — do NOT attempt without a
  // backfill migration.
  id            String                @id @default(uuid()) @db.Uuid
  walletId      String                @db.Uuid
  wallet        Wallet                @relation(fields: [walletId], references: [id], onDelete: Cascade)
  type          WalletTransactionType
  amount        Decimal               @db.Decimal(10, 2)
  balanceAfter  Decimal               @db.Decimal(10, 2)
  description   String
  referenceType WalletReferenceType
  referenceId   String?
  createdAt     DateTime              @default(now()) @db.Timestamptz(6)

  @@unique([walletId, referenceId])
  @@index([walletId, createdAt])
  @@index([referenceId])
  @@map("wallet_transactions")
}

enum SubscriptionPlan {
  FREE
  PREMIUM
}

enum SubscriptionStatus {
  PENDING
  ACTIVE
  CANCELLED
  EXPIRED
}

model Subscription {
  id                   String             @id @default(uuid()) @db.Uuid
  userId               String             @db.Uuid
  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan                 SubscriptionPlan   @default(FREE)
  status               SubscriptionStatus @default(ACTIVE)
  startsAt             DateTime           @db.Timestamptz(6)
  expiresAt            DateTime           @db.Timestamptz(6)
  paymentId            String?            @unique @db.Uuid
  payment              Payment?           @relation("SubscriptionPayment", fields: [paymentId], references: [id])
  autoRenew            Boolean            @default(true)
  renewalAttempts      Int                @default(0)
  lastRenewalAttemptAt DateTime?          @db.Timestamptz(6)
  createdAt            DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime           @updatedAt @db.Timestamptz(6)

  // #D2 composite for per-user subscription lookups by status.
  @@index([userId, status])
  @@map("subscriptions")
}

// -----------------------------------------------------------------------------
// PLATFORM MODELS
// -----------------------------------------------------------------------------

enum NotificationChannel {
  IN_APP
  SMS
  EMAIL
  PUSH
}

model Notification {
  id        String              @id @default(uuid()) @db.Uuid
  userId    String              @db.Uuid
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String
  channel   NotificationChannel
  isRead    Boolean             @default(false)
  metadata  Json?
  createdAt DateTime            @default(now()) @db.Timestamptz(6)
  readAt    DateTime?           @db.Timestamptz(6)

  @@index([userId, isRead])
  @@index([createdAt])
  @@map("notifications")
}

model PushToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  token      String
  platform   String    @default("mobile")
  isActive   Boolean   @default(true)
  lastUsedAt DateTime? @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime  @updatedAt @db.Timestamptz(6)

  @@unique([userId, token])
  @@index([userId, isActive])
  @@map("push_tokens")
}

model NotificationPreference {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @unique @db.Uuid
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  emailEnabled    Boolean  @default(true)
  smsEnabled      Boolean  @default(true)
  pushEnabled     Boolean  @default(true)
  quietHoursStart String? // "22:00:00"
  quietHoursEnd   String? // "07:00:00"
  updatedAt       DateTime @updatedAt @db.Timestamptz(6)

  @@map("notification_preferences")
}

model IdempotencyKey {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  key         String
  method      String
  path        String
  requestHash String?
  statusCode  Int      @default(0)
  response    Json?
  createdAt   DateTime @default(now()) @db.Timestamptz(6)

  @@unique([userId, key])
  @@index([createdAt])
  @@map("idempotency_keys")
}

model AuditLog {
  id           String   @id @default(uuid()) @db.Uuid
  actorId      String?  @db.Uuid
  actor        User?    @relation(fields: [actorId], references: [id])
  action       String
  resourceType String
  resourceId   String?
  metadata     Json?
  ipAddress    String?
  userAgent    String?
  deviceId     String?
  riskScore    Int? // 0-100 risk score for the event
  createdAt    DateTime @default(now()) @db.Timestamptz(6)

  @@index([actorId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

enum ProviderEarningStatus {
  PENDING
  AVAILABLE
  PAID_OUT
}

model ProviderEarning {
  id              String                @id @default(uuid()) @db.Uuid
  providerId      String                @db.Uuid
  provider        User                  @relation(fields: [providerId], references: [id])
  appointmentId   String                @db.Uuid
  appointment     Appointment           @relation(fields: [appointmentId], references: [id])
  amount          Decimal               @db.Decimal(10, 2)
  status          ProviderEarningStatus @default(PENDING)
  payoutReference String?
  createdAt       DateTime              @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime              @updatedAt @db.Timestamptz(6)

  @@index([providerId])
  @@index([status])
  @@unique([appointmentId, providerId])
  @@map("provider_earnings")
}

model RewardPoint {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @db.Uuid
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  points        Int
  reason        String
  referenceType String?
  referenceId   String?
  createdAt     DateTime @default(now()) @db.Timestamptz(6)

  @@map("reward_points")
}

model RewardTransaction {
  id              String                @id @default(uuid()) @db.Uuid
  userId          String                @db.Uuid
  user            User                  @relation(fields: [userId], references: [id], onDelete: Cascade, name: "UserRewardTransactions")
  type            RewardTransactionType
  points          Int
  source          RewardSource
  description     String
  referenceId     String?
  status          TransactionStatus     @default(COMPLETED)
  rewardCatalogId String?               @db.Uuid
  rewardCatalog   RewardCatalog?        @relation(fields: [rewardCatalogId], references: [id])
  shippingAddress Json?
  deliveredAt     DateTime?             @db.Timestamptz(6)
  createdAt       DateTime              @default(now()) @db.Timestamptz(6)

  // Unique constraint to prevent duplicate point awards for same event
  @@unique([userId, source, referenceId, type])
  @@map("reward_transactions")
}

enum RewardTransactionType {
  EARN
  REDEEM
}

enum RewardSource {
  APPOINTMENT
  PRESCRIPTION
  PHARMACY_ORDER
  REFERRAL
  SIGNUP
  PROMOTION
  REDEMPTION
}

enum TransactionStatus {
  PENDING
  PROCESSING
  DELIVERED
  REDEEMED
  CANCELLED
  COMPLETED
}

model Address {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @db.Uuid
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  addressLine1 String
  addressLine2 String?
  city         String
  state        String
  country      String   @default("Nigeria")
  postalCode   String?
  latitude     Decimal? @db.Decimal(10, 8)
  longitude    Decimal? @db.Decimal(11, 8)
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now()) @db.Timestamptz(6)

  @@map("addresses")
}

model ChatThread {
  id           String            @id @default(uuid()) @db.Uuid
  createdAt    DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime          @updatedAt @db.Timestamptz(6)
  participants ChatParticipant[]
  messages     ChatMessage[]

  @@map("chat_threads")
}

model ChatParticipant {
  id       String     @id @default(uuid()) @db.Uuid
  threadId String     @db.Uuid
  thread   ChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  userId   String     @db.Uuid
  user     User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt DateTime   @default(now()) @db.Timestamptz(6)

  @@unique([threadId, userId])
  @@map("chat_participants")
}

model ChatMessage {
  id        String               @id @default(uuid()) @db.Uuid
  threadId  String               @db.Uuid
  thread    ChatThread           @relation(fields: [threadId], references: [id], onDelete: Cascade)
  senderId  String               @db.Uuid
  sender    User                 @relation(fields: [senderId], references: [id], onDelete: Cascade)
  body      String?
  fileUrl   String?
  fileName  String?
  fileSize  Int?
  createdAt DateTime             @default(now()) @db.Timestamptz(6)
  receipts  ChatMessageReceipt[]

  @@index([threadId, createdAt])
  @@index([senderId])
  @@map("chat_messages")
}

model ChatMessageReceipt {
  id        String      @id @default(uuid()) @db.Uuid
  messageId String      @db.Uuid
  message   ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String      @db.Uuid
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  readAt    DateTime    @default(now()) @db.Timestamptz(6)

  @@unique([messageId, userId])
  @@map("chat_message_receipts")
}

enum MDTStatus {
  DRAFT
  OPEN
  ACTIVE
  CLOSED
}

model MDT {
  id          String    @id @default(uuid()) @db.Uuid
  title       String
  patientId   String    @db.Uuid
  patient     User      @relation("MdtPatient", fields: [patientId], references: [id])
  creatorId   String    @db.Uuid
  creator     User      @relation("MdtCreator", fields: [creatorId], references: [id])
  status      MDTStatus @default(OPEN)
  complaint   String    @db.Text
  history     String?   @db.Text
  pastHistory String?   @db.Text
  diagnosis   String?   @db.Text
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(6)

  participants MDTParticipant[]
  rooms        TelemedicineRoom[]

  @@map("mdts")
}

model MDTParticipant {
  id       String   @id @default(uuid()) @db.Uuid
  mdtId    String   @db.Uuid
  mdt      MDT      @relation(fields: [mdtId], references: [id], onDelete: Cascade)
  userId   String   @db.Uuid
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role     String?
  joinedAt DateTime @default(now()) @db.Timestamptz(6)

  @@unique([mdtId, userId])
  @@map("mdt_participants")
}

model Product {
  id                   String   @id @default(uuid()) @db.Uuid
  pharmacyId           String   @db.Uuid
  pharmacy             User     @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  name                 String
  description          String?  @db.Text
  price                Decimal  @db.Decimal(10, 2)
  stock                Int      @default(0)
  category             String?
  imageUrl             String?
  requiresPrescription Boolean  @default(false)
  // #P2 NAFDAC: optional registration number for regulated products.
  // Verified at app layer (pharmacy controller); nullable so existing rows safe.
  nafdacRegNo String?
  // #P3 Controlled-drug schedule (e.g. "CONTROLLED"). Nullable; enforced in
  // createOrder qty cap via (product as any).schedule until client regen.
  schedule   String?
  // Stock traceability. A product listing represents one sellable batch until
  // dedicated multi-batch receiving is introduced.
  batchNumber String?
  supplierName String?
  expiryDate DateTime? @db.Date
  isActive             Boolean  @default(true)
  createdAt            DateTime @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime @updatedAt @db.Timestamptz(6)

  @@index([pharmacyId])
  @@index([pharmacyId, name])
  @@index([category])
  @@index([isActive])
  @@index([expiryDate])
  @@map("products")
}

model RewardCatalog {
  id           String              @id @default(uuid()) @db.Uuid
  name         String
  description  String?
  pointsCost   Int
  category     String              @default("general")
  imageUrl     String?
  stock        Int                 @default(100)
  isActive     Boolean             @default(true)
  tierRequired RewardTier?
  createdAt    DateTime            @default(now()) @db.Timestamptz(6)
  redeemedBy   User[]              @relation("RewardRedeemedBy")
  transactions RewardTransaction[]

  @@map("reward_catalogs")
}

enum RewardTier {
  BRONZE
  SILVER
  GOLD
  PLATINUM
}

enum OutboxStatus {
  PENDING
  SENDING
  SENT
  FAILED
}

model OutboxEvent {
  id            String       @id @default(uuid()) @db.Uuid
  type          String
  channel       String
  recipient     String
  payload       Json
  status        OutboxStatus @default(PENDING)
  attempts      Int          @default(0)
  nextAttemptAt DateTime     @default(now()) @db.Timestamptz(6)
  createdAt     DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime     @updatedAt @db.Timestamptz(6)

  @@index([status, nextAttemptAt])
  @@map("outbox_events")
}

// -----------------------------------------------------------------------------
// COMPLIANCE MODELS (#C1 leave, #F2 referral — nullable-safe new tables)
// -----------------------------------------------------------------------------

// #C1 Leave: provider unavailability day. Unique per provider+date.
model ProviderLeave {
  id         String   @id @default(uuid()) @db.Uuid
  providerId String   @db.Uuid
  provider   User     @relation(fields: [providerId], references: [id], onDelete: Cascade)
  date       DateTime @db.Date
  reason     String?
  createdAt  DateTime @default(now()) @db.Timestamptz(6)

  @@unique([providerId, date])
  @@index([providerId])
  @@map("provider_leaves")
}

// #F2 Referral: provider-to-provider handoff with patient consent timestamp.
model Referral {
  id             String    @id @default(uuid()) @db.Uuid
  fromProviderId String    @db.Uuid
  fromProvider   User      @relation("ReferralFrom", fields: [fromProviderId], references: [id], onDelete: Cascade)
  toProviderId   String    @db.Uuid
  toProvider     User      @relation("ReferralTo", fields: [toProviderId], references: [id], onDelete: Cascade)
  patientId      String    @db.Uuid
  patient        User      @relation("ReferralPatient", fields: [patientId], references: [id], onDelete: Cascade)
  reason         String?   @db.Text
  consentAt      DateTime? @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @db.Timestamptz(6)

  @@index([fromProviderId])
  @@index([toProviderId])
  @@index([patientId])
  @@map("referrals")
}

// -----------------------------------------------------------------------------
// COMPLIANCE MODELS (#L1 consent history, #L3 erasure queue)
// -----------------------------------------------------------------------------

// #L1 Consent history: every versioned consent grant is appended here;
// User.consentVersion/consentAt mirror the latest grant.
model ConsentHistory {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  version     String
  consentedAt DateTime @default(now()) @db.Timestamptz(6)
  ip          String?

  @@index([userId, consentedAt])
  @@map("consent_history")
}

enum ErasureStatus {
  PENDING
  PROCESSING
  DONE
}

// #L3 Erasure queue: DELETE /users/me files a request and deactivates the
// account. A back-office worker performs the actual anonymization
// (TODO: worker not yet implemented — see requestErasure in user.controller);
// rows under prescription legal hold are rejected with 409 and never queued.
model ErasureRequest {
  id        String        @id @default(uuid()) @db.Uuid
  userId    String        @unique @db.Uuid
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  status    ErasureStatus @default(PENDING)
  createdAt DateTime      @default(now()) @db.Timestamptz(6)

  @@map("erasure_requests")
}

// #20 Review: one patient rating per completed visit. appointmentId unique
// enforces one-review-per-visit at the DB layer.
model Review {
  id            String      @id @default(uuid()) @db.Uuid
  appointmentId String      @unique @db.Uuid
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  patientId     String      @db.Uuid
  patient       User        @relation("ReviewPatient", fields: [patientId], references: [id], onDelete: Cascade)
  providerId    String      @db.Uuid
  provider      User        @relation("ReviewProvider", fields: [providerId], references: [id], onDelete: Cascade)
  rating        Int
  comment       String?     @db.Text
  createdAt     DateTime    @default(now()) @db.Timestamptz(6)

  @@index([providerId])
  @@index([patientId])
  @@map("reviews")
}

// #C3 Disputes: user-filed support tickets triaged by SUPER_ADMIN.
// Status transitions OPEN -> IN_PROGRESS -> RESOLVED are app-layer only;
// the table carries no workflow constraints so existing rows stay safe.
enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

model SupportTicket {
  id        String              @id @default(uuid()) @db.Uuid
  userId    String              @db.Uuid
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject   String
  body      String              @db.Text
  status    SupportTicketStatus @default(OPEN)
  createdAt DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt DateTime            @updatedAt @db.Timestamptz(6)

  @@index([userId])
  @@index([status])
  @@map("support_tickets")
}
