{
  "compilerOptions": {
    "target": "es2022",
    "module": "commonjs",
    "lib": ["es2022"],
    "declaration": true,
    "sourceMap": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "dist",
    "resolveJsonModule": true,
    // NOTE: dev/test resolution targets live sources (ts-node chromatic DX;
    // Jest additionally pins sources via moduleNameMapper). Production builds
    // use per-project tsconfig.build.json (composite + project references),
    // which redirect cross-package imports to declaration outputs and emit
    // flat, runnable dist/ trees. Always build via `tsc -b`.
    "paths": {
      "@ricton/shared/jobs": ["./packages/shared/src/jobs"],
      "@ricton/*": ["./packages/*/src", "./services/*/src"]
    }
  }
}
