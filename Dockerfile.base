FROM node:20-alpine AS ricton-base

RUN apk add --no-cache openssl openssl-dev curl

WORKDIR /app

COPY package*.json ./
COPY tsconfig*.json ./

COPY packages/ ./packages/
COPY services/ ./services/

# Install ALL workspace deps once — avoids 17 parallel npm ci network hammers.
RUN npm ci --fetch-retries=5 --fetch-retry-mintimeout=20000 --fetch-retry-maxtimeout=120000

# Generate Prisma client with linux-musl-openssl-3.0.x target (Alpine 3.20+ uses OpenSSL 3.x).
RUN npm run generate --workspace=@ricton/db

# Build shared packages that every service depends on.
RUN npm run build --workspace=@ricton/shared --workspace=@ricton/db --workspace=@ricton/auth-middleware
