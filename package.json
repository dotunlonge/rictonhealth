{
  "name": "ricton-api",
  "version": "1.0.0",
  "private": true,
  "description": "Ricton Healthcare Platform Backend Monorepo",
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "workspaces": [
    "packages/*",
    "services/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run format && npm run lint:fix && docker-compose up -d --scale auth-service=0 --scale user-service=0 --scale payment-service=0 --scale wallet-service=0 --scale docs-service=0 && npm run docs:generate && npm run services:dev",
    "dev:all": "bash scripts/dev-up.sh",
    "dev:down": "bash scripts/dev-down.sh",
    "prod:up": "docker compose -f docker-compose.prod.yml --env-file .env.production up -d",
    "services:dev": "REDIS_URL=${REDIS_URL:-redis://localhost:6379} REDIS_PASSWORD=${REDIS_PASSWORD:-ricton-secure-redis-2026} concurrently -c \"cyan,magenta,yellow,blue,green\" \"npm run dev -w @ricton/auth-service\" \"npm run dev -w @ricton/user-service\" \"npm run dev -w @ricton/payment-service\" \"npm run dev -w @ricton/wallet-service\" \"npm run dev -w @ricton/docs-service\"",
    "worker": "JWT_SECRET=worker-secret npx ts-node -O '{\"module\":\"commonjs\"}' -e \"import('./packages/shared/src/jobs/processors').then(m => m.startJobProcessors())\"",
    "build": "npm run build --workspaces --if-present",
    "build:smartguard": "bash scripts/build-smartguard.sh",
    "build:smartguard:exe": "pkg --targets node20-win-x64 --output dist/smartguard/smartguard.exe services/smartguard/dist/index.js",
    "build:smartguard:dng": "tar -czf dist/smartguard/smartguard.dng -C services/smartguard/dist --transform 's|^|smartguard/|' .",
    "test": "./scripts/test-e2e.sh",
    "test:contracts": "jest --runInBand --runTestsByPath tests/*.test.ts",
    "test:integration": "jest services/ packages/shared/tests/ --runInBand",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "format": "prettier --write \"**/*.{ts,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,json,md}\"",
    "typecheck": "tsc -b tsconfig.build.json && npm run typecheck:seeds --workspace=@ricton/db",
    "db:push": "npm run push --workspace=@ricton/db",
    "db:migrate": "npm run migrate --workspace=@ricton/db",
    "db:generate": "npm run generate --workspace=@ricton/db",
    "db:seed": "npm run seed --workspace=@ricton/db",
    "docs:generate": "npm run build --workspace=@ricton/shared && JWT_SECRET=docs-generation-secret DATABASE_URL=postgresql://localhost:5432/ricton npx ts-node -O '{\"module\":\"commonjs\"}' scripts/generate-docs.ts",
    "prepare": "husky || true"
  },
  "lint-staged": {
    "**/*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "**/*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@react-native/jest-preset": "0.86.3",
    "@types/jest": "^29.5.12",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.19.43",
    "@types/opossum": "^8.1.9",
    "@typescript-eslint/eslint-plugin": "^7.8.0",
    "@typescript-eslint/parser": "^7.8.0",
    "autocannon": "^8.0.0",
    "concurrently": "^9.2.3",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "js-yaml": "^5.1.0",
    "lint-staged": "^16.4.0",
    "openapi-types": "^12.1.3",
    "openapi-typescript-codegen": "^0.29.0",
    "pkg": "^5.8.1",
    "prettier": "^3.2.5",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "swagger-jsdoc": "^6.2.8",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5"
  },
  "dependencies": {
    "@types/uuid": "^10.0.0",
    "bullmq": "^5.20.0",
    "react-is": "^19.2.8",
    "uuid": "^14.0.1",
    "react-native": "0.86.3"
  },
  "overrides": {
    "react": "19.2.4",
    "react-dom": "19.2.4"
  }
}
