{
  "name": "ricton-api",
  "version": "1.0.0",
  "private": true,
  "description": "Ricton Healthcare Platform Backend Monorepo",
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "workspaces": [
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "dev": "npm run format && npm run lint:fix && docker-compose up -d && npm run docs:generate && npm run services:dev",
    "services:dev": "concurrently -c \"cyan,magenta,yellow,blue,green\" \"npm run dev -w @ricton/auth-service\" \"npm run dev -w @ricton/user-service\" \"npm run dev -w @ricton/payment-service\" \"npm run dev -w @ricton/wallet-service\" \"npm run dev -w @ricton/docs\"",
    "build": "npm run build --workspace=@ricton/db --workspace=@ricton/shared --workspace=@ricton/auth-middleware --workspace=@ricton/auth-service --workspace=@ricton/user-service --workspace=@ricton/payment-service --workspace=@ricton/wallet-service --workspace=@ricton/appointment-service",
    "test": "./scripts/test-e2e.sh",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "format": "prettier --write \"**/*.{ts,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,json,md}\"",
    "typecheck": "tsc -b tsconfig.build.json",
    "db:push": "npm run push --workspace=@ricton/db",
    "db:migrate": "npm run migrate --workspace=@ricton/db",
    "db:generate": "npm run generate --workspace=@ricton/db",
    "db:seed": "npm run seed --workspace=@ricton/db",
    "docs:generate": "npx tsx scripts/generate-docs.ts",
    "prepare": "husky"
  },
  "lint-staged": {
    "**/*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "**/*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.19.43",
    "@typescript-eslint/eslint-plugin": "^7.8.0",
    "@typescript-eslint/parser": "^7.8.0",
    "concurrently": "^9.2.3",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "js-yaml": "^5.1.0",
    "lint-staged": "^16.4.0",
    "openapi-typescript-codegen": "^0.29.0",
    "prettier": "^3.2.5",
    "swagger-jsdoc": "^6.2.8",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5"
  },
  "dependencies": {
    "@types/uuid": "^10.0.0",
    "uuid": "^14.0.1"
  }
}
