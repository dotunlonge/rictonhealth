{
  "name": "mobile",
  "version": "1.0.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "main": "expo-router/entry",
  "dependencies": {
    "@react-native-async-storage/async-storage": "^3.1.1",
    "@ricton/api-contract": "0.1.0",
    "@ricton/design-tokens": "0.1.0",
    "expo": "~57.0.24",
    "expo-apple-authentication": "^57.0.2",
    "expo-auth-session": "^57.0.12",
    "expo-camera": "^57.0.4",
    "expo-constants": "~57.0.17",
    "expo-dev-client": "~57.0.18",
    "expo-image-picker": "^57.0.17",
    "expo-linking": "~57.0.9",
    "expo-location": "~57.0.19",
    "expo-router": "~57.0.18",
    "expo-secure-store": "~57.0.3",
    "expo-status-bar": "~57.0.1",
    "livekit-client": "^2.22.3",
    "lucide-react-native": "^1.26.0",
    "react": "19.2.4",
    "react-native": "0.86.0",
    "react-native-safe-area-context": "^5.8.0",
    "react-native-screens": "^4.26.2",
    "react-native-svg": "^15.15.5",
    "react-native-webview": "^13.16.1"
  },
  "devDependencies": {
    "@react-native/jest-preset": "^0.86.3",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.2",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.5",
    "react-test-renderer": "19.2.3",
    "test-renderer": "^1.2.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:ci": "jest --runInBand",
    "e2e": "maestro test e2e/foundation e2e/auth/05-password-login.yaml e2e/auth/06-invalid-login.yaml",
    "e2e:auth": "maestro test e2e/auth",
    "e2e:discovery": "maestro test e2e/discovery",
    "e2e:booking": "maestro test e2e/booking",
    "e2e:prescriptions": "maestro test e2e/prescriptions",
    "e2e:telemedicine": "maestro test e2e/telemedicine",
    "e2e:pharmacy": "maestro test e2e/pharmacy",
    "e2e:wallet": "maestro test e2e/wallet",
    "e2e:subscription": "maestro test e2e/subscription",
    "e2e:messages": "maestro test e2e/messages",
    "e2e:account": "maestro test e2e/account",
    "e2e:audit": "jest --runInBand --runTestsByPath __tests__/release-hardening.test.ts"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.ts"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/e2e/"
    ],
    "modulePaths": [
      "<rootDir>/node_modules"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|expo-router|@expo/.*|react-native-svg|lucide-react-native)"
    ]
  },
  "private": true
}
