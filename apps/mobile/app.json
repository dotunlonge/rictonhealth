{
  "expo": {
    "name": "Ricton Health",
    "slug": "ricton-health",
    "scheme": [
      "ricton",
      "com.googleusercontent.apps.648128561576-qnd6isvap6q5ce1rsn5m0cl35gftblrt"
    ],
    "version": "1.0.0",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.ricton.health",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.ricton.health",
      "adaptiveIcon": {
        "backgroundColor": "#F0F7FF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": true
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true,
          "faceIDPermission": "Allow Ricton Health to unlock your secure patient session."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Ricton Health to use your camera for video visits with your clinician.",
          "microphonePermission": "Allow Ricton Health to use your microphone so your clinician can hear you.",
          "recordAudioAndroid": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
